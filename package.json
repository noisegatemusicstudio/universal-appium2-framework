{
  "name": "mobile-e2e-template",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable native mobile E2E testing template with WebdriverIO, Cucumber, TypeScript, and Appium",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test:android": "wdio run ./wdio.android.conf.ts",
    "test:ios": "wdio run ./wdio.ios.conf.ts",
    "appium:drivers:android": "appium driver install uiautomator2",
    "appium:drivers:ios": "appium driver install xcuitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"features/**/*.ts\" \"*.ts\" \"*.json\" \".github/workflows/*.yml\" \".github/copilot-instructions.md\" \"README.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"features/**/*.ts\" \"*.ts\" \"*.json\" \".github/workflows/*.yml\" \".github/copilot-instructions.md\" \"README.md\""
  },
  "overrides": {
    "body-parser": "2.4.0",
    "sharp": "0.35.5",
    "shell-quote": "1.12.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.11",
    "@wdio/allure-reporter": "10.1.0",
    "@wdio/appium-service": "10.1.0",
    "@wdio/cli": "10.1.0",
    "@wdio/cucumber-framework": "10.1.0",
    "@wdio/globals": "10.1.0",
    "@wdio/local-runner": "10.1.0",
    "@wdio/spec-reporter": "10.1.0",
    "@wdio/types": "10.1.0",
    "appium": "3.8.0",
    "dotenv": "18.0.8",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
