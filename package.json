{
  "name": "@universal/appium2-framework",
  "version": "1.0.0",
  "description": "📱 Universal Appium2 Mobile Testing Framework - Plug-and-play testing for any mobile application",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:android": "jest --config jest.android.config.js",
    "test:ios": "jest --config jest.ios.config.js",
    "test:headed": "jest --verbose",
    "test:debug": "jest --detectOpenHandles --forceExit",
    "lint": "eslint src tests --ext .ts,.js",
    "lint:fix": "eslint src tests --ext .ts,.js --fix",
    "format": "prettier --write \"src/**/*.{ts,js}\" \"tests/**/*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js}\" \"tests/**/*.{ts,js}\"",
    "start:appium": "appium server --port 4723",
    "start:android": "adb devices",
    "start:ios": "xcrun simctl list devices",
    "setup": "./setup.sh",
    "prepare": "npm run build"
  },
  "keywords": [
    "appium",
    "appium2",
    "mobile-testing",
    "automation",
    "android",
    "ios",
    "testing-framework",
    "typescript",
    "universal",
    "reusable",
    "plug-and-play"
  ],
  "author": "Noise Gate Music Studio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noisegatemusicstudio/universal-appium2-framework.git"
  },
  "bugs": {
    "url": "https://github.com/noisegatemusicstudio/universal-appium2-framework/issues"
  },
  "homepage": "https://github.com/noisegatemusicstudio/universal-appium2-framework#readme",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@wdio/logger": "^8.38.0",
    "allure-commandline": "^2.29.0",
    "allure-jest": "^2.15.0",
    "appium": "^2.11.2",
    "appium-uiautomator2-driver": "^3.7.9",
    "appium-xcuitest-driver": "^7.25.6",
    "dotenv": "^16.4.5",
    "webdriverio": "^8.39.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "files": [
    "dist",
    "src",
    "tests",
    "config",
    "docs",
    "README.md",
    "LICENSE"
  ]
}
