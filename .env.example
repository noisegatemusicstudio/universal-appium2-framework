# Environment Configuration for Appium2 Framework
# Copy this file to .env and update values for your specific app and environment

# =============================================
# ANDROID CONFIGURATION
# =============================================

# Android App Details
ANDROID_APP_PACKAGE=com.example.app
ANDROID_APP_ACTIVITY=.MainActivity
ANDROID_APP_PATH=/path/to/your/app.apk

# Android Device/Emulator
ANDROID_DEVICE_NAME=Pixel_7_API_33
ANDROID_PLATFORM_VERSION=13.0
ANDROID_AUTOMATION_NAME=UiAutomator2

# Android Emulator Settings
ANDROID_AVD=Pixel_7_API_33
ANDROID_AVD_TIMEOUT=120000

# =============================================
# iOS CONFIGURATION
# =============================================

# iOS App Details
IOS_BUNDLE_ID=com.example.app
IOS_APP_PATH=/path/to/your/app.app

# iOS Device/Simulator
IOS_DEVICE_NAME=iPhone 14 Pro
IOS_PLATFORM_VERSION=16.0
IOS_AUTOMATION_NAME=XCUITest

# iOS Simulator Settings
IOS_SIMULATOR_STARTUP_TIMEOUT=120000

# =============================================
# APPIUM SERVER CONFIGURATION
# =============================================

# Appium Server
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723

# Server Timeouts (in milliseconds)
NEW_COMMAND_TIMEOUT=300000
SESSION_OVERRIDE=true

# =============================================
# TEST CONFIGURATION
# =============================================

# Test Timeouts
DEFAULT_WAIT_TIMEOUT=10000
ELEMENT_WAIT_TIMEOUT=15000
PAGE_LOAD_TIMEOUT=30000

# Test Data
TEST_DATA_LOCALE=en_US
GENERATE_REALISTIC_DATA=true

# Screenshots and Reporting
CAPTURE_SCREENSHOTS=true
SCREENSHOTS_DIR=./test-results/screenshots
REPORTS_DIR=./test-results/reports

# =============================================
# LOGGING CONFIGURATION
# =============================================

# Log Levels: error, warn, info, debug, trace
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/appium-tests.log

# Appium Logging
APPIUM_LOG_LEVEL=info
APPIUM_LOG_TIMESTAMP=true

# =============================================
# PERFORMANCE CONFIGURATION
# =============================================

# Performance Monitoring
ENABLE_PERFORMANCE_MONITORING=true
PERFORMANCE_METRICS_INTERVAL=5000

# Video Recording (for debugging)
ENABLE_VIDEO_RECORDING=false
VIDEO_RECORDING_DIR=./test-results/videos

# =============================================
# PARALLEL EXECUTION
# =============================================

# Parallel Testing
MAX_PARALLEL_SESSIONS=2
PARALLEL_ANDROID_PORTS=4723,4724
PARALLEL_IOS_PORTS=4725,4726

# =============================================
# CI/CD CONFIGURATION
# =============================================

# CI Environment Detection
CI_MODE=false
HEADLESS_MODE=false

# Retry Configuration
MAX_TEST_RETRIES=2
RETRY_DELAY=5000

# =============================================
# DEVELOPMENT/DEBUG CONFIGURATION
# =============================================

# Development Mode
DEV_MODE=true
DEBUG_MODE=false

# Element Highlighting (for debugging)
HIGHLIGHT_ELEMENTS=false
ELEMENT_HIGHLIGHT_DURATION=2000

# Slow Mode (for debugging)
SLOW_MODE=false
SLOW_MODE_DELAY=1000
